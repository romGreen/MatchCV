# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database - PostgreSQL
DATABASE_URL="postgresql://matchcv:123456@localhost:5432/matchcv?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:8081"

# Logging
LOG_LEVEL=info

# Location Services
DEFAULT_SEARCH_RADIUS=5000
MAX_SEARCH_RADIUS=50000
