{
  "name": "@matchcv/backend",
  "version": "1.0.0",
  "description": "MatchCV Backend API Server",
  "main": "dist/index.js",
  "private": true,
  "packageManager": "npm@10",
  "scripts": {
    "dev": "tsx watch src/index.ts",
